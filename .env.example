# Kestrel configuration template.
# Copy to `.env` and fill in. NEVER commit `.env` — it is git-ignored.
# All variables are prefixed KESTREL_ (see kestrel/config/settings.py).

# --- environment: backtest | paper   ('live' is rejected until Phase 6 sign-off)
KESTREL_ENVIRONMENT=backtest

# --- universe & data
# eToro symbols, e.g. AAPL,MSFT,BTC,ETH
KESTREL_SYMBOLS=
KESTREL_TIMEFRAME=1d
KESTREL_MARKET_DATA_PROVIDER=csv

# --- broker: eToro
KESTREL_BASE_CURRENCY=GBP
# An eToro short is a CFD, not a holding. Leave false.
KESTREL_ALLOW_SHORT=false
# Instruments that pay the 1% crypto fee each side.
KESTREL_CRYPTO_SYMBOLS=
# Instruments bought straight from a GBP balance (0.75% FX each side). Leave
# empty if you fund a USD balance once and trade USD instruments from it.
KESTREL_FX_SYMBOLS=

# --- risk. These are risk/return knobs; change them deliberately.
KESTREL_ACCOUNT_EQUITY=100000
KESTREL_RISK_PER_TRADE=0.005
KESTREL_ATR_MULTIPLIER=2.0
KESTREL_MAX_CONCURRENT_POSITIONS=3
KESTREL_MAX_PAIRWISE_CORRELATION=0.7
# Intentionally blank: the drawdown hard-stop must be chosen explicitly in Phase 3.
KESTREL_MAX_DAILY_DRAWDOWN=
KESTREL_MAX_TOTAL_DRAWDOWN=
KESTREL_SIZING_MODE=vol_target
KESTREL_KELLY_FRACTION=0.25

# --- backtest fill model (eToro cost structure)
KESTREL_COMMISSION_BPS=0
KESTREL_CRYPTO_FEE_BPS=100
KESTREL_FX_FEE_BPS=75
KESTREL_SLIPPAGE_BPS=2
# eToro minimum trade: USD 10
KESTREL_MIN_ORDER_VALUE=10

# --- notifications: Signal (via a signal-cli-rest-api container you run)
KESTREL_SIGNAL_API_URL=http://localhost:8080
# The number the container is linked to, in international format.
KESTREL_SIGNAL_SENDER=
# Who gets the messages: numbers and/or group ids, comma-separated.
KESTREL_SIGNAL_RECIPIENTS=
KESTREL_DISPLAY_TIMEZONE=Europe/London

# --- secrets (leave blank for backtesting)
# eToro: Settings -> Trading -> API Key Management -> Create New Key.
# A key is Demo OR Real; paper mode needs a Demo key. Read permission only.
# The User Key is shown once.
KESTREL_BROKER_API_KEY=
KESTREL_BROKER_USER_KEY=
KESTREL_NEWS_API_KEY=
